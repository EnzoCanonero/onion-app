{
  "name": "focustree",
  "private": true,
  "version": "0.1.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "clean": "node scripts/clean-app-data.mjs",
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "build:web": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "third-party-notices": "node scripts/generate-third-party-notices.mjs",
    "package": "electron-vite build && npm run third-party-notices && electron-builder",
    "package:mac": "electron-vite build && npm run third-party-notices && electron-builder --mac",
    "package:win": "electron-vite build && npm run third-party-notices && electron-builder --win",
    "package:linux": "electron-vite build && npm run third-party-notices && electron-builder --linux"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "electron-vite": "^3.0.0",
    "vite": "^6.0.0"
  }
}
